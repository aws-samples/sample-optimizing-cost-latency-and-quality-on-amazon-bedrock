# AWS Credentials
# Option 1: Use AWS CLI credentials (recommended)
# AWS_PROFILE=dev
# AWS_REGION=us-east-1
# If you have AWS CLI configured, leave these commented out
# boto3 will automatically use credentials from ~/.aws/credentials

# Option 2: Use environment variables
# Uncomment and set these if you prefer to use .env file
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token
# AWS_DEFAULT_REGION=us-east-1

# CloudFormation Stack Names
INFRA_STACK_NAME=prompt-workshop-infra
COGNITO_STACK_NAME=prompt-workshop-cognito
LANGFUSE_STACK_NAME=prompt-workshop-langfuse
CODE_EDITOR_STACK_NAME=prompt-workshop-code-editor
GATE_STACK_NAME=prompt-workshop-gate

# Observability: both clients are installed; start with AWS-native telemetry.
OBSERVABILITY_BACKEND=agentcore

# Langfuse alternative: use LangfuseUrl from your workshop stack outputs and
# the API keys for your Langfuse project. Uncomment after filling in the values.
# LANGFUSE_PUBLIC_KEY=your-project-public-key
# LANGFUSE_SECRET_KEY=your-project-secret-key
# LANGFUSE_BASE_URL=https://your-workshop-langfuse-url
